<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net5.0;net6.0;net7.0;net8.0;net9.0;net48;netstandard2.1</TargetFrameworks>
		<Authors>DomCr</Authors>
		<PackageId>ACadSharp.Pdf</PackageId>
		<PackageTags>C# Dwg Dxf Pdf</PackageTags>
		<RepositoryUrl>https://github.com/DomCR/ACadSharp.Pdf</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/DomCR/ACadSharp.Pdf</PackageProjectUrl>
		<Copyright>Copyright (c) 2024 Albert Domenech</Copyright>
		<Description>Library to generate Pdf files from dwg and dxf files read by ACadSharp.</Description>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>0.1.5-beta</Version>
		<PackageOutputPath>../nupkg</PackageOutputPath>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>../ACadSharp.Pdf.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(Configuration)' != 'Release'">
		<ProjectReference Include="..\ACadSharp\src\ACadSharp\ACadSharp.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="ACadSharp" Version="3.3.*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Clipper2" Version="2.0.0" />
		<PackageReference Include="Docnet.Core" Version="2.6.0" />
		<PackageReference Include="Svg.Skia" Version="3.4.1" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
		<PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.2" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
	</ItemGroup>

	<Import Project="..\ACadSharp\src\CSUtilities\CSUtilities\CSUtilities.projitems" Label="Shared" />

</Project>
